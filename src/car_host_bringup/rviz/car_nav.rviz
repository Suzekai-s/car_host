Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/ToolManager
    Name: Tool Manager

Visualization Manager:
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: map
      Distance: 8.0
      Yaw: 1.57
      Pitch: 0.524

Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Reference Frame: map
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR Scan
    Topic: /scan
    Size (m): 0.05
    Style: Points
    Color: 255; 255; 0
  - Class: rviz_default_plugins/Map
    Name: Map
    Topic: /map
    Color Scheme: map
    Alpha: 0.7
  - Class: rviz_default_plugins/PoseArray
    Name: AMCL Particles
    Topic: /particlecloud
    Color: 0; 200; 0
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Topic: /plan
    Color: 255; 0; 0
  - Class: rviz_default_plugins/Path
    Name: Local Plan
    Topic: /local_plan
    Color: 0; 0; 255
  - Class: rviz_default_plugins/Pose
    Name: Goal Pose
    Topic: /goal_pose
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Topic: /global_costmap/costmap
    Color Scheme: costmap
    Alpha: 0.3
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Topic: /local_costmap/costmap
    Color Scheme: costmap
    Alpha: 0.3
